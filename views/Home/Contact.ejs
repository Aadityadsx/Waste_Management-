<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 mt-12 mb-12">
    <header class="text-center mb-12">
        <div style="font-size:55px">📞</div>
        <h1 class="font-bold text-green-700">Contact Us</h1>
        <p class="text-slate-500 text-xl">Have a question or need help? We're here to help.</p>
    </header>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
        <div class="md:col-span-5">
            <section class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200 shadow-xl border-0 h-full"><div class="p-6 md:p-12">
                <h2 class="text-green-700 font-bold mb-4">🌱 Get In Touch</h2>
                <p class="text-slate-500 mb-4">If you have questions about reporting waste, tracking complaints or using the system, you can contact us using the information below.</p>
                <div class="flex mb-4"><div class="text-3xl mr-3">📧</div><div><h5 class="font-bold mb-1">Email</h5><a id="supportEmail" href="mailto:support@wastemanagement.com">support@wastemanagement.com</a></div></div>
                <div class="flex mb-4"><div class="text-3xl mr-3">📱</div><div><h5 class="font-bold mb-1">Phone</h5><a href="tel:+919876543210">+91 98765 43210</a></div></div>
                <div class="flex mb-4"><div class="text-3xl mr-3">📍</div><div><h5 class="font-bold mb-1">Location</h5><p class="text-slate-500 mb-0">Local Municipal Office</p></div></div>
                <div class="flex"><div class="text-3xl mr-3">🕒</div><div><h5 class="font-bold mb-1">Working Hours</h5><p class="text-slate-500 mb-0">Monday - Saturday<br>9:00 AM - 6:00 PM</p></div></div>
            </div></section>
        </div>
        <div class="md:col-span-7">
            <section class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200 shadow-xl border-0"><div class="p-6 md:p-12">
                <h2 class="text-green-700 font-bold mb-4">✉️ Send Us a Message</h2>
                <form id="contactForm">
                    <div class="mb-3"><label class="mb-1 block text-sm font-semibold text-slate-700 font-bold" for="contactName">Your Name</label><input type="text" id="contactName" name="name" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-md placeholder:text-slate-400 focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-200" placeholder="Enter your name" required></div>
                    <div class="mb-3"><label class="mb-1 block text-sm font-semibold text-slate-700 font-bold" for="contactEmail">Email Address</label><input type="email" id="contactEmail" name="email" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-md placeholder:text-slate-400 focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-200" placeholder="Enter your email" required></div>
                    <div class="mb-3"><label class="mb-1 block text-sm font-semibold text-slate-700 font-bold" for="contactSubject">Subject</label><input type="text" id="contactSubject" name="subject" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-md placeholder:text-slate-400 focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-200" placeholder="Enter subject" required></div>
                    <div class="mb-4"><label class="mb-1 block text-sm font-semibold text-slate-700 font-bold" for="contactMessage">Message</label><textarea id="contactMessage" name="message" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-md placeholder:text-slate-400 focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-200" rows="6" placeholder="Write your message here..." required></textarea></div>
                    <div class="text-center"><button type="submit" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-green-700 text-white hover:bg-green-800 focus-visible:ring-green-600 px-12">📩 Send Message</button></div>
                </form>
                <p class="text-sm text-slate-500 mt-3 mb-0">Your default email app will open so you can review and send your message.</p>
            </div></section>
        </div>
    </div>
    <section class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200 border-0 mt-12"><div class="p-6 text-center">
        <h3 class="text-green-700 font-bold">♻️ Need Help With a Complaint?</h3>
        <p class="text-slate-500">You can report waste and track your complaint directly from the Waste Management System.</p>
        <a href="/Waste/Report" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-green-700 text-white hover:bg-green-800 focus-visible:ring-green-600 mr-2">📝 Report Waste</a>
        <a href="/Waste/Track" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 border border-green-700 bg-white text-green-800 hover:bg-green-50 focus-visible:ring-green-600">📍 Track Complaint</a>
    </div></section>
</div>
<script>
    document.getElementById("contactForm").addEventListener("submit", function (event) {
        event.preventDefault();
        const form = new FormData(this);
        const body = ["Name: " + form.get("name"), "Email: " + form.get("email"), "", form.get("message")].join("\n");
        const query = new URLSearchParams({ subject: form.get("subject"), body });
        window.location.href = document.getElementById("supportEmail").href + "?" + query;
    });
</script>
