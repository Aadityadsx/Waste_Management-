<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> - Waste Management System</title>
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <main class="login-container">
        <section class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200 shadow-lg p-12 text-center" style="max-width:600px">
            <h1><%= title %></h1>
            <% if (error) { %><p><%= error.message %></p><% } %>
            <a class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-green-700 text-white hover:bg-green-800 focus-visible:ring-green-600" href="/">Back to Home</a>
        </section>
    </main>
</body>
</html>
