<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 mt-12 mb-12">
    <section class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200 shadow-lg">
        <header class="bg-green-700 px-12 py-4 text-white bg-cyan-700"><h3 class="mb-0">Complaint Details</h3></header>
        <div class="p-6">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Complaint ID</strong></div><div class="md:col-span-8">#<%= complaint.ComplaintID %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Name</strong></div><div class="md:col-span-8"><%= complaint.Name %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Location</strong></div><div class="md:col-span-8"><%= complaint.Location %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Waste Type</strong></div><div class="md:col-span-8"><%= complaint.WasteType %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Description</strong></div><div class="md:col-span-8"><%= complaint.Description %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Report Date</strong></div><div class="md:col-span-8"><%= dateLabel(complaint.ReportDate) %></div></div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3"><div class="md:col-span-4"><strong>Status</strong></div><div class="md:col-span-8"><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold bg-green-700"><%= complaint.Status %></span></div></div>
        </div>
        <footer class="border-t border-slate-200 px-12 py-4"><a href="/Waste/MyComplaints" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-slate-600 text-white hover:bg-slate-700 focus-visible:ring-slate-500">← Back to My Complaints</a><a href="/Waste/Track" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-blue-700 text-white hover:bg-blue-800 focus-visible:ring-blue-600">Track Status</a></footer>
    </section>
</div>
