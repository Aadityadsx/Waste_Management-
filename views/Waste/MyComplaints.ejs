<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 mt-4">
    <% if (resolutionMessage) { %><div class="rounded-lg border p-6 border-green-200 bg-green-50 text-green-800 text-center shadow-md"><strong>✓ Notification</strong><br><%= resolutionMessage %></div><% } %>
    <% if (flash.successMessage) { %><div class="rounded-lg border p-6 border-green-200 bg-green-50 text-green-800 text-center">✓ <%= flash.successMessage %></div><% } %>
    <% if (flash.errorMessage) { %><div class="rounded-lg border p-6 border-red-200 bg-red-50 text-red-800 text-center"><%= flash.errorMessage %></div><% } %>
    <h2 class="text-center mb-4">My Complaints</h2>
    <% if (!complaints.length) { %>
        <div class="rounded-lg border p-6 border-sky-200 bg-sky-50 text-sky-800 text-center">You have not submitted any waste complaints yet.</div>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm striped-table">
                <thead class="bg-green-50 text-green-900"><tr><th>Complaint ID</th><th>Location</th><th>Waste Type</th><th>Description</th><th>Report Date</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                    <% complaints.forEach(complaint => { %>
                        <tr>
                            <td><strong>#<%= complaint.ComplaintID %></strong></td><td><%= complaint.Location %></td><td><%= complaint.WasteType %></td><td><%= complaint.Description %></td><td><%= dateLabel(complaint.ReportDate) %></td>
                            <td><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= complaint.Status === 'Pending' ? 'bg-amber-400 text-slate-950' : complaint.Status === 'In Progress' ? 'bg-blue-700 text-white' : complaint.Status === 'Collected' || complaint.Status === 'Resolved' ? 'bg-green-700 text-white' : 'bg-slate-600 text-white' %> "><%= complaint.Status %></span></td>
                            <td><a href="/Waste/Details/<%= complaint.ComplaintID %>" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-cyan-700 text-white hover:bg-cyan-800 focus-visible:ring-cyan-600 px-3 py-1.5 text-sm mb-1">View Details</a>
                                <% if (complaint.Status === "Resolved") { %><br><a href="/Feedback/Create?complaintId=<%= complaint.ComplaintID %>" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-amber-400 text-slate-950 hover:bg-amber-500 focus-visible:ring-amber-500 px-3 py-1.5 text-sm mt-1">⭐ Give Feedback</a><% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
    <div class="text-center mt-3"><a href="/Waste/Report" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-green-700 text-white hover:bg-green-800 focus-visible:ring-green-600">Report New Waste</a><a href="/" class="inline-flex items-center justify-center rounded-lg px-4 py-2 font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 bg-slate-600 text-white hover:bg-slate-700 focus-visible:ring-slate-500">Back to Home</a></div>
</div>
