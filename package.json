{
  "name": "waste-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Waste Management System built with Node.js, Express, EJS, and SQL Server.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/css/site.css --minify",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "pretest": "npm run build:css"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "csrf-sync": "^4.2.1",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "msnodesqlv8": "^5.6.0",
    "mssql": "^12.7.4"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
